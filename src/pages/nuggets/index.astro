---
import ArchiveTable from '@/components/ArchiveTable.astro';
import NewsletterBlock from '@/components/NewsletterBlock.astro';
import SpecStrip from '@/components/SpecStrip.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { nuggetCount, UI } from '@/config/site';
import { allNuggets } from '@/lib/nuggets';

const nuggets = await allNuggets();
---

<BaseLayout
	title="Alle Nuggets"
	description="Das vollständige Archiv: Notizen aus der Praxis zu Digitalisierung im HR, KI & Daten und moderner HR-Organisation."
	active="nuggets"
>
	<SpecStrip
		back={{ href: '/', label: UI.backHome }}
		items={['ARCHIV']}
		accent={nuggetCount(nuggets.length)}
	/>

	<div class="head">
		<h1>Alle Nuggets</h1>
		<p>Alles, was bisher erschienen ist &mdash; neueste zuerst.</p>
	</div>

	{
		nuggets.length > 0 ? (
			<ArchiveTable nuggets={nuggets} label={UI.archive} />
		) : (
			<p class="empty">Noch nichts veröffentlicht. Das erste Nugget kommt bald.</p>
		)
	}

	<NewsletterBlock />
</BaseLayout>

<style>
	.head {
		border-bottom: var(--rule);
		padding: 48px var(--pad-band-lg);
	}

	h1 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--fs-h1);
		line-height: 1;
		letter-spacing: var(--track-display);
		margin-bottom: 14px;
	}

	.head p {
		font-size: var(--fs-dek);
		color: var(--body-soft);
	}

	.empty {
		border-bottom: var(--rule);
		padding: 48px var(--pad-band-lg);
		font-family: var(--font-mono);
		font-size: var(--fs-mono);
		color: var(--muted);
	}

	@media (max-width: 759px) {
		.head,
		.empty {
			padding: 28px var(--pad-band);
		}
	}
</style>
