---
import SpecStrip from '@/components/SpecStrip.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { UI } from '@/config/site';
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite existiert nicht.">
	<SpecStrip back={{ href: '/', label: UI.backHome }} items={['FEHLER']} accent="404" />

	<div class="body">
		<p class="code">404</p>
		<h1>Diese Seite gibt es nicht.</h1>
		<p class="dek">
			Der Link ist womöglich veraltet, oder ich habe etwas verschoben. Das Archiv hat alles, was
			erschienen ist.
		</p>
		<div class="actions">
			<a class="btn" href="/nuggets/">ZUM ARCHIV &rarr;</a>
			<a class="btn ghost" href="/">{UI.backHome}</a>
		</div>
	</div>
</BaseLayout>

<style>
	.body {
		padding: 72px var(--pad-band-lg) 80px;
	}

	.code {
		font-family: var(--font-mono);
		font-size: var(--fs-mono-sm);
		font-weight: 600;
		letter-spacing: var(--track-label-wide);
		color: var(--accent);
		margin-bottom: 24px;
	}

	h1 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--fs-hero);
		line-height: var(--lh-hero);
		letter-spacing: var(--track-display);
		margin-bottom: 24px;
	}

	.dek {
		font-size: 17px;
		line-height: var(--lh-body);
		color: var(--body-soft);
		max-width: 520px;
		margin-bottom: 36px;
	}

	.actions {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}

	.btn {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: var(--track-label-tight);
		background: var(--ink);
		color: var(--on-dark);
		border: var(--rule);
		padding: 15px 24px;
		text-decoration: none;
	}
	.btn:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-dark);
		text-decoration: none;
	}

	.btn.ghost {
		background: transparent;
		color: var(--ink);
	}
	.btn.ghost:hover {
		background: var(--ink);
		color: var(--on-dark);
	}

	@media (max-width: 759px) {
		.body {
			padding: 40px var(--pad-band) 48px;
		}
	}
</style>
