---
import Fill from '@/components/Fill.astro';
import LegalLayout from '@/layouts/LegalLayout.astro';
import { isPublishReady, missingOwnerFields, OWNER, SITE } from '@/config/site';

const ready = isPublishReady();
const missing = missingOwnerFields();
---

<LegalLayout
	title="Impressum"
	description="Anbieterkennzeichnung nach § 5 DDG."
	label="IMPRESSUM"
	accent="§ 5 DDG"
>
	{
		!ready && (
			<p class="notice">
				NOCH NICHT VERÖFFENTLICHUNGSREIF. Offen in <code>src/config/site.ts</code>:{' '}
				{missing.join(', ')}. Ein unvollständiges Impressum ist abmahnfähig. Diese Seite ist eine
				Vorlage und ersetzt keine Rechtsberatung.
			</p>
		)
	}

	<h2>Angaben gemäß § 5 DDG</h2>
	<p>
		{SITE.author}<br />
		<Fill value={OWNER.street} placeholder="STRASSE UND HAUSNUMMER" /><br />
		<Fill value={OWNER.postalCity} placeholder="PLZ UND ORT" /><br />
		{OWNER.country}
	</p>

	<h2>Kontakt</h2>
	<p>
		E-Mail: <Fill value={OWNER.email} placeholder="E-MAIL-ADRESSE" />
		{
			OWNER.phone && (
				<>
					<br />
					Telefon: {OWNER.phone}
				</>
			)
		}
	</p>

	<h2>Verantwortlich für den Inhalt</h2>
	<p>{SITE.author}, Anschrift wie oben.</p>

	<h2>Umsatzsteuer-Identifikationsnummer</h2>
	<p>ENTFÄLLT, DA PRIVATES ANGEBOT</p>

	<h2>Hinweis zur Tätigkeit</h2>
	<p>
		Dieser Blog ist ein privates Angebot. Die hier veröffentlichten Beiträge geben ausschließlich
		meine persönliche Auffassung wieder und nicht die Position meines Arbeitgebers.
	</p>

	<h2>Streitschlichtung</h2>
	<p>
		Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer
		Verbraucherschlichtungsstelle teilzunehmen.
	</p>

	<h2>Haftung für Links</h2>
	<p>
		Dieses Angebot enthält Links zu externen Websites Dritter, auf deren Inhalte ich keinen Einfluss
		habe. Für diese fremden Inhalte kann ich keine Gewähr übernehmen; verantwortlich ist stets der
		jeweilige Anbieter oder Betreiber der Seiten. Bei Bekanntwerden von Rechtsverletzungen werden
		derartige Links umgehend entfernt.
	</p>
</LegalLayout>
