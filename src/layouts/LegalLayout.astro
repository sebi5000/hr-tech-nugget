---
import SpecStrip from '@/components/SpecStrip.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { UI } from '@/config/site';

interface Props {
	title: string;
	description: string;
	label: string;
	accent?: string | undefined;
}

const { title, description, label, accent } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<SpecStrip back={{ href: '/', label: UI.backHome }} items={[label]} accent={accent} />

	<div class="legal">
		<h1>{title}</h1>
		<slot />
	</div>
</BaseLayout>

<style is:global>
	.legal {
		padding: 48px var(--pad-band-lg) 56px;
		max-width: 760px;
	}

	.legal h1 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--fs-h1);
		line-height: 1;
		letter-spacing: var(--track-display);
		margin-bottom: 32px;
	}

	.legal h2 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 22px;
		line-height: var(--lh-heading);
		margin: 36px 0 14px;
		padding-top: 20px;
		border-top: var(--rule);
	}

	.legal p {
		font-size: 16px;
		line-height: 1.7;
		color: var(--body);
		margin-bottom: 16px;
	}

	.legal ul {
		font-size: 16px;
		line-height: 1.7;
		color: var(--body);
		margin: 0 0 16px;
		padding-left: 22px;
	}

	.legal li {
		margin-bottom: 8px;
	}

	.legal a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	/* Anything the site owner still has to fill in. */
	.legal .todo {
		font-family: var(--font-mono);
		font-size: var(--fs-mono);
		background: var(--paper-alt);
		border-left: 3px solid var(--accent);
		padding: 4px 8px;
		display: inline-block;
	}

	.legal .notice {
		border: var(--rule);
		padding: 20px 24px;
		margin-bottom: 28px;
		font-family: var(--font-mono);
		font-size: var(--fs-mono);
		line-height: 1.6;
		color: var(--muted-strong);
	}

	@media (max-width: 759px) {
		.legal {
			padding: 28px var(--pad-band) 36px;
		}
	}
</style>
