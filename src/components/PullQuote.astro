---
interface Props {
	/** Span both columns instead of staying inside the measure. */
	bleed?: boolean;
}

const { bleed = false } = Astro.props;
---

<blockquote class:list={['pullquote', { bleed }]}>
	<p><slot /></p>
</blockquote>

<style>
	.pullquote {
		background: var(--ink);
		color: var(--on-dark);
		padding: 36px 40px;
		margin: 36px 0;
	}

	.pullquote p {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 24px;
		line-height: 1.35;
	}

	/* Typographic quotes belong to the component, so authors never type them. */
	.pullquote p::before {
		content: '\201E';
	}
	.pullquote p::after {
		content: '\201C';
	}

	@media (max-width: 759px) {
		.pullquote {
			padding: 24px var(--pad-band);
			margin: 28px 0;
		}
		.pullquote p {
			font-size: 19px;
		}
	}
</style>

<style is:global>
	.prose > .pullquote.bleed {
		grid-column: 1 / -1;
	}
</style>
