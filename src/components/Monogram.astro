---
import { SITE } from '@/config/site';

interface Props {
	size?: number;
}

const { size = 64 } = Astro.props;
const stroke = size >= 100 ? 3 : 2;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 120 120"
	fill="none"
	role="img"
	aria-label={SITE.author}
>
	<rect
		x={stroke / 2}
		y={stroke / 2}
		width={120 - stroke}
		height={120 - stroke}
		fill="var(--paper)"
		stroke="var(--ink)"
		stroke-width={stroke}></rect>
	<text
		x="60"
		y="78"
		font-family="var(--font-display)"
		font-size="46"
		font-weight="700"
		fill="var(--ink)"
		text-anchor="middle">{SITE.authorInitials}</text
	>
</svg>
