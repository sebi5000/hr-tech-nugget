---
import { NEWSLETTER_ENABLED, OWNER, UI } from '@/config/site';

/**
 * Buttondown embed. Deliberately a real form POST, not fetch — Buttondown may
 * need to show a CAPTCHA or a validation error on their own page. The reader
 * therefore lands on Buttondown after submitting; that is the cost of shipping
 * no JavaScript.
 *
 * The CSP in public/_headers must allow `form-action https://buttondown.com`
 * or this silently fails in production.
 *
 * Dormant until OWNER.buttondownUser is set: the whole block renders nothing,
 * so no half-finished signup is ever shown. Filling in the username is the
 * only switch — there is no second flag to forget.
 */
const action = `https://buttondown.com/api/emails/embed-subscribe/${OWNER.buttondownUser}`;
---

{
	NEWSLETTER_ENABLED && (
		<section class="newsletter on-dark" id="newsletter">
			<div class="copy">
				<h2>{UI.newsletterHeading}</h2>
				<p>{UI.newsletterSub}</p>
			</div>

			<form class="form" action={action} method="post">
				<label class="sr-only" for="bd-email">
					E-Mail-Adresse
				</label>
				<input
					id="bd-email"
					type="email"
					name="email"
					required
					autocomplete="email"
					placeholder={UI.emailPlaceholder}
				/>
				<input type="hidden" name="embed" value="1" />
				<button type="submit">{UI.subscribe}</button>
			</form>
		</section>
	)
}

<style>
	.newsletter {
		background: var(--ink);
		color: var(--on-dark);
		padding: 44px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 48px;
		flex-wrap: wrap;
	}

	.copy {
		max-width: 560px;
	}

	h2 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 30px;
		line-height: var(--lh-tight);
		margin-bottom: 10px;
	}

	.copy p {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
		color: var(--on-dark-muted);
	}

	.form {
		display: flex;
	}

	input[type='email'] {
		font-family: var(--font-mono);
		font-size: var(--fs-mono);
		padding: 15px 18px;
		border: 2px solid var(--on-dark);
		border-right: none;
		background: var(--ink);
		color: var(--on-dark);
		width: 280px;
	}
	input[type='email']::placeholder {
		color: var(--on-dark-muted);
	}

	button {
		font-family: var(--font-mono);
		font-size: var(--fs-mono);
		font-weight: 600;
		letter-spacing: var(--track-label-tight);
		padding: 15px 26px;
		background: var(--accent);
		color: var(--on-dark);
		border: 2px solid var(--accent);
		cursor: pointer;
	}
	button:hover {
		background: var(--accent-hover);
		border-color: var(--accent-hover);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 979px) {
		.newsletter {
			flex-direction: column;
			align-items: stretch;
			gap: 24px;
		}
		.form {
			flex-direction: column;
			gap: 10px;
		}
		input[type='email'] {
			width: 100%;
			border-right: 2px solid var(--on-dark);
		}
		button {
			width: 100%;
		}
	}

	@media (max-width: 759px) {
		.newsletter {
			padding: 28px var(--pad-band);
		}
		h2 {
			font-size: 24px;
		}
		.copy p {
			font-size: var(--fs-mono-xs);
		}
	}
</style>
