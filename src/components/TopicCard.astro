---
import TopicIcon from '@/components/TopicIcon.astro';
import { nuggetCount, type Topic } from '@/config/site';

interface Props {
	topic: Topic;
	count: number;
}

const { topic, count } = Astro.props;
---

<a class="card" href={`/themen/${topic.id}/`}>
	<div class="head">
		<span class="order">{topic.order}</span>
		<span class="icon"><TopicIcon topic={topic.id} /></span>
	</div>
	<h3>{topic.title}</h3>
	<p class="dek">{topic.dek}</p>
	<p class="count">{nuggetCount(count)} &rarr;</p>
</a>

<style>
	.card {
		color: inherit;
		text-decoration: none;
		padding: var(--pad-band);
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.card:hover {
		background: var(--paper-alt);
		color: inherit;
		text-decoration: none;
	}

	.head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}

	.order {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		color: var(--accent);
	}

	.icon {
		color: var(--ink);
		display: block;
	}

	h3 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--fs-h3);
		line-height: var(--lh-heading);
	}

	.dek {
		font-size: var(--fs-sm);
		line-height: 1.55;
		color: var(--muted-strong);
	}

	.count {
		font-family: var(--font-mono);
		font-size: var(--fs-mono-sm);
		letter-spacing: var(--track-label-tight);
		color: var(--muted);
		margin-top: 4px;
	}

	@media (max-width: 759px) {
		.card {
			padding: 22px var(--pad-band);
		}
	}
</style>
